 ];
 
@@ -150,6 +154,25 @@
         return Ok(dir);
     }
 
+    // A byte-identical prefix of the known patch series can be extended without
+    // reinstalling LLVM. Unknown or changed stamps still take the clean path.
+    if installed && patch_frontend {
+        if let Ok(recorded) = fs::read_to_string(&stamp) {
+            for count in 1..PATCHES.len() {
+                if recorded == patch_stamp(&PATCHES[..count]) {
+                    for (name, contents) in &PATCHES[count..] {
+                        PBAR.info(&format!("{CONFIG}Applying {name}"));
+                        apply_patch(&frontend, contents)
+                            .with_context(|| format!("Applying {name}"))?;
+                    }
+                    let _ = fs::remove_file(frontend.join("cache/sysroot_install.stamp"));
+                    fs::write(&stamp, &expected_stamp)?;
+                    return Ok(dir);
+                }
+            }
+        }
+    }
+
     let python = which::which("python3")
         .or_else(|_| which::which("python"))
         .map_err(|_| anyhow!("python3 is required to install the Emscripten SDK"))?;
@@ -194,7 +217,11 @@
 }
 
 fn stamp_contents() -> String {
-    PATCHES
+    patch_stamp(PATCHES)
+}
+
+fn patch_stamp(patches: &[(&str, &str)]) -> String {
+    patches
         .iter()
         .map(|(name, contents)| format!("{name} {:016x}\n", fnv1a(contents.as_bytes())))
         .collect()

