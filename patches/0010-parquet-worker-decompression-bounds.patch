+// Streaming codecs must not grow a Vec beyond the page's declared size on Workers.
+#[cfg(target_os = "emscripten")]
+fn worker_decompress(mut reader: impl std::io::Read, output: &mut Vec<u8>, expected: Option<usize>) -> Result<usize> {
+    let cap = expected.unwrap_or(8 * 1024 * 1024).min(8 * 1024 * 1024);
+    let mut total = 0usize;
+    let mut chunk = [0u8; 8192];
+    loop {
+        let n = reader.read(&mut chunk)?;
+        if n == 0 { return Ok(total); }
+        if n > cap.saturating_sub(total) { return Err(ParquetError::General("Worker decompression budget exceeded".into())); }
+        output.extend_from_slice(&chunk[..n]);
+        total += n;
+    }
+}
