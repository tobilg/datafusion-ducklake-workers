+/// Cargo 1.100 places native link output in build/<package>/<hash>/out,
+/// then uplifts only the JS/WASM. Match the exact uplifted JS, never a stale
+/// hash directory, before collecting wasm-bindgen's companion snippets.
+pub fn snippet_dir(out: &Path, js: &str) -> Result<Option<PathBuf>> {
+    let pattern = format!("{}/build/*/*/out/*.js", glob::Pattern::escape(&out.to_string_lossy()));
+    for candidate in glob::glob(&pattern)? {
+        let candidate = candidate?;
+        if fs::read_to_string(&candidate)? == js {
+            let snippets = candidate.parent().unwrap().join("snippets");
+            if snippets.is_dir() {
+                return Ok(Some(snippets));
+            }
+        }
+    }
+    // Layout used by the beta on which the upstream builder was introduced.
+    let legacy = out.join("deps/snippets");
+    Ok(legacy.is_dir().then_some(legacy))
+}
