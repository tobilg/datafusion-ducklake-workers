{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datafusion-quacklake-unconfigured",
  "main": "build/full/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "new_module_registry"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "bash scripts/build.sh --variant full"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "QUERY_MODE": "ducklake",
    "STORAGE_BACKEND": "r2_binding",
    "QUACK_URI": "quack:catalog.example.com:443",
    "CATALOG_ID": "analytics",
    "CATALOG_BUCKET": "replace-with-your-bucket",
    "CATALOG_DATA_PATH": "r2://replace-with-your-bucket/catalogs/analytics/"
  },
  "r2_buckets": [
    {
      "binding": "CATALOG_R2",
      "bucket_name": "replace-with-your-bucket"
    }
  ]
}
