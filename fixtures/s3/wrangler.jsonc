{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "datafusion-s3-local-probe",
  "main": "../../build/full/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "new_module_registry"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "STORAGE_BACKEND": "s3",
    "QUACK_URI": "quack:127.0.0.1:8792",
    "CATALOG_DATA_PATH": "r2://quacklake-fixture/catalogs/fixture/",
    "S3_ENDPOINT": "http://127.0.0.1:9000",
    "S3_BUCKET": "quacklake-fixture",
    "S3_REGION": "us-east-1",
    "S3_ADDRESSING_STYLE": "path",
    "ALLOW_LOCAL_HTTP": "true",
    "CATALOG_BUCKET": "quacklake-fixture",
    "CATALOG_ID": "fixture"
  }
}
