{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datafusion-core-unconfigured",
  "main": "build/core/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "new_module_registry"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "bash scripts/build.sh --variant core"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "QUERY_MODE": "files"
  }
}
